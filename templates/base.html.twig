<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Gestion Etudiant</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
    <body>
        {% block menu %}
            <!-- En-tête horizontal -->
            <header class="sticky top-0 z-10 border-b border-slate-800 bg-slate-900/95 backdrop-blur">
            <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-10">
                <div>
                <p class="text-xl font-bold text-white">Gestion Etudiant</p>
                <p class="text-sm text-slate-500">Suivi des étudiants et des notes</p>
                </div>
                <nav class="flex gap-2 overflow-x-auto text-sm font-medium">
                <a href="{{url("app_etudiant")}}" class="shrink-0 rounded-lg bg-slate-800 px-3.5 py-2 text-white">Étudiants</a>
                {# <a href="{{url("app_note")}}" class="shrink-0 rounded-lg px-3.5 py-2 text-slate-400 hover:bg-slate-800 hover:text-white">Notes</a> #}
                </nav>
            </div>
            </header>
             <main class="mx-auto max-w-7xl px-4 py-8 sm:px-8 lg:px-10 space-y-10">
        {% endblock %}
        {% block body %}
            
        {% endblock %}
    </body>
</html>
