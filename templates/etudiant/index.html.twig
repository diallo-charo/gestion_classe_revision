{% extends 'base.html.twig' %}

{% block title %}Etudiant{% endblock %}
{% block menu %}
    {{ parent() }}
{% endblock %}
{% block body %}
      <!-- Liste + formulaire côte à côte -->
      <div class="grid gap-8 lg:grid-cols-[minmax(0,35fr)_minmax(0,65fr)] lg:items-start">

      <!-- Liste des étudiants -->
      <section id="liste" class="scroll-mt-28 min-w-0 lg:order-2">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h1 class="text-2xl font-bold text-white">Liste des étudiants</h1>
            <p class="text-sm text-slate-500 mt-1">{{etudiants | length}} étudiants inscrits</p>
          </div>
        </div>

        {# <form action="{{url("app_etudiant")}}" method="get" class="mt-5 flex max-w-lg gap-2">
          <label for="recherche" class="sr-only">Rechercher un étudiant</label>
          <input id="recherche" name="matricule" type="search" placeholder="Rechercher par nom ou matricule"
                 class="min-w-0 flex-1 rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-slate-200 placeholder-slate-500 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30">
          <button type="submit" name="btn_search" class="shrink-0 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-950">
            Rechercher
          </button>
        </form> #}

        {{ form_start(fromSearchEtudiant,{'attr':{"class":"mt-5 flex max-w-lg gap-2"}}) }}
            {{ form_widget(fromSearchEtudiant.matricule,{"attr":{"class":"min-w-0 flex-1 rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-sm text-slate-200 placeholder-slate-500 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30"}}) }}
            {{ form_widget(fromSearchEtudiant.submit,{"label":"Rechercher","attr":{"class":"shrink-0 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-950"}}) }}
        {{ form_end(fromSearchEtudiant) }}

        <div class="mt-4 overflow-x-auto rounded-xl border border-slate-800 bg-slate-900 shadow-lg shadow-black/20">
          <table class="min-w-full divide-y divide-slate-800 text-sm">
            <thead class="bg-slate-800/60 text-left text-slate-400">
              <tr>
                <th scope="col" class="px-5 py-3 font-semibold">Nom complet</th>
                <th scope="col" class="px-5 py-3 font-semibold">Matricule</th>
                <th scope="col" class="px-5 py-3 font-semibold">Date de naissance</th>
                <th scope="col" class="px-5 py-3 font-semibold">Notes</th>
                <th scope="col" class="px-5 py-3 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            {% for etudiant in etudiants %}
                
            <tbody class="divide-y divide-slate-800">
              <tr class="hover:bg-slate-800/50">
                <td class="px-5 py-3.5 font-medium text-white">{{ etudiant.nomComplet }}</td>
                <td class="px-5 py-3.5 text-slate-400">{{ etudiant.matricule }}</td>
                <td class="px-5 py-3.5 text-slate-400">{{ etudiant.dateNaissance | date("d/m/Y") }}</td>
                <td class="px-5 py-3.5"><span class="rounded-full bg-blue-500/15 px-2.5 py-1 text-xs font-medium text-blue-300">{{ etudiant.notes | length }}</span></td>
                <td class="px-5 py-3.5 text-right whitespace-nowrap">
                  <a href="{{ path('app_note', {'id_note': etudiant.id}) }}" name class="font-medium text-blue-400 hover:text-blue-300" >Voir</a>
                  <a href="#ajout" class="ml-4 font-medium text-slate-400 hover:text-white">Modifier</a>
                  <a href="#" class="ml-4 font-medium text-red-400 hover:text-red-300">Supprimer</a>
                </td>
              </tr>
            </tbody>
            {% endfor %}

          </table>
        </div>
      </section>

      <!-- Formulaire d'ajout -->
      <section id="ajout" class="scroll-mt-28 min-w-0 lg:order-1 lg:sticky lg:top-28">
        <h2 class="text-xl font-bold text-white">Ajouter un étudiant</h2>
        <p class="text-sm text-slate-500 mt-1">Renseignez les informations de l'étudiant.</p>

        <form action="#" method="post" class="mt-5 rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20">
          <div class="grid gap-5">
            <div>
              <label for="nomComplet" class="block text-sm font-medium text-slate-300">Nom complet</label>
              <input id="nomComplet" name="nomComplet" type="text" required placeholder="Ex. Diallo Mamadou"
                     class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3.5 py-2.5 text-sm text-slate-200 placeholder-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30">
            </div>
            <div>
              <label for="matricule" class="block text-sm font-medium text-slate-300">Matricule</label>
              <input id="matricule" name="matricule" type="text" required placeholder="Ex. ISM-2024-005"
                     class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3.5 py-2.5 text-sm text-slate-200 placeholder-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30">
            </div>
            <div>
              <label for="dateNaissance" class="block text-sm font-medium text-slate-300">Date de naissance</label>
              <input id="dateNaissance" name="dateNaissance" type="date" required
                     class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3.5 py-2.5 text-sm text-slate-200 [color-scheme:dark] focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30">
            </div>
          </div>

          <div class="mt-6 flex flex-col-reverse gap-3">
            <a href="#liste" class="inline-flex justify-center rounded-lg border border-slate-700 px-4 py-2.5 text-sm font-semibold text-slate-300 hover:bg-slate-800">Annuler</a>
            <button type="submit" class="inline-flex justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-900">
              Enregistrer l'étudiant
            </button>
          </div>
        </form>
      </section>

      </div>
{% endblock %}
