{% extends 'base.html.twig' %}

{% block title %} NoteController!{% endblock %}

{% block body %}
         <!-- Notes d'un étudiant -->
      {% if notesEtudiant != null %}
      <section id="notes" class="scroll-mt-28">
        <h2 class="text-xl font-bold text-white">Notes de {{ notesEtudiant[0].etudiant.nomComplet }}</h2>
        <p class="text-sm text-slate-500 mt-1">Matricule  {{ notesEtudiant[0].etudiant.matricule }}</p>

        <div class="mt-5 grid gap-6 lg:grid-cols-3">
          <div class="lg:col-span-2 overflow-x-auto rounded-xl border border-slate-800 bg-slate-900 shadow-lg shadow-black/20">
            <table class="min-w-full divide-y divide-slate-800 text-sm">
              <thead class="bg-slate-800/60 text-left text-slate-400">
                <tr>
                  <th scope="col" class="px-5 py-3 font-semibold">Matière</th>
                  <th scope="col" class="px-5 py-3 font-semibold text-right">Note sur 20</th>
                </tr>
              </thead>
              {% for note in notesEtudiant %}  
              <tbody class="divide-y divide-slate-800">
                <tr class="hover:bg-slate-800/50">
                  <td class="px-5 py-3.5">{{note.matiere}}</td>
                  <td class="px-5 py-3.5 text-right font-medium text-white">{{note.valeur}}</td>
                </tr>   
              </tbody>
              {% endfor %}

            </table>
          </div>
        {% endif %}
        {% if notesEtudiant == null %}
                  <!-- Cas : l'étudiant n'a aucune note -->
        <div class="mt-10">
          {# <h3 class="text-lg font-bold text-white">Notes de Awa Ba</h3>
          <p class="text-sm text-slate-500 mt-1">Matricule ISM-2024-004</p> #}

          <div class="mt-5 rounded-xl border border-dashed border-slate-700 bg-slate-900 px-6 py-12 text-center">
            <svg class="mx-auto h-10 w-10 text-slate-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m5.231 13.481L15 17.25m-4.5-15H5.625c-.621 0-1.125.504-1.125 1.125v16.5c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Zm3.75 11.625a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
            </svg>
            <h4 class="mt-4 text-base font-semibold text-white">Aucune note enregistrée</h4>
            <p class="mx-auto mt-1 max-w-sm text-sm text-slate-500">Cet étudiant n'a pas encore de note. La moyenne générale sera calculée dès que la première note sera ajoutée.</p>
            <a href="#" class="mt-6 inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-950">
              Ajouter une note
            </a>
          </div>
        </div>
        {% endif %}
        

          <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 self-start">
            <p class="text-sm font-medium text-slate-500">Moyenne générale</p>
            <p class="mt-2 text-4xl font-bold text-white">13,8<span class="text-lg font-medium text-slate-500"> / 20</span></p>
            <div class="mt-4 h-2 overflow-hidden rounded-full bg-slate-800">
              <div class="h-full w-[69%] rounded-full bg-blue-500"></div>
            </div>
          </div>
        </div>
      </section>

    </main>
  </div>

</body>
</html>
{% endblock %}
